# Starts the `thales-scc` minikube profile with the distro (re-enabled 2026-09-17).
#
# History: this unit was disabled on 2026-08-12 when the default `minikube`
# profile sat idle for 27 days and was deleted. On 2026-09-01 the Tals project
# built `thales-scc` (OpenShift restricted-v2 SCC emulation: PSA restricted +
# Kyverno) and it holds the thales-dev / thales-pre-prod stacks. After a WSL
# restart on 2026-09-17 every compose service came back and the cluster did not:
# the node container has restart=no and nothing started it.
#
# `-p thales-scc` is load-bearing. Without it `minikube start` builds a NEW, EMPTY
# default cluster and switches the kube context away from thales-scc.
#
# `minikube start` rather than `docker update --restart`: start also re-syncs the
# apiserver's host port into ~/.kube/config (it changes on every start), certs
# and the node IP. A container restart alone leaves kubectl pointing at a dead port.
#
# The host-port forwards (31080 pre-prod, 31081 dev) are USER units
# (~/.config/systemd/user/thales-{preprod,dev}-forward.service) with
# Restart=always; they loop until the apiserver answers. They run with nobody
# logged in only because devssh has linger enabled (`loginctl enable-linger`).

[Unit]
Description=minikube profile thales-scc (Tals OpenShift-emulation cluster) for devssh
After=docker.service network-online.target wsl-fix-mtu.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=devssh
Group=devssh
Environment=HOME=/home/devssh
Environment=PATH=/home/devssh/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/devssh/.local/share/mise/shims/minikube start -p thales-scc
ExecStop=/home/devssh/.local/share/mise/shims/minikube stop -p thales-scc
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
