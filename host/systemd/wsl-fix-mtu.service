[Unit]
Description=Restore eth0 MTU to 1500 (WSL inherits 1280 from the Windows Tailscale adapter)
Documentation=https://github.com/YehudaBriskman/Bothy/blob/main/docs/kb/incidents/2026-08-30-wsl-eth0-mtu-1280.md
After=network.target
Before=tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/wsl-fix-mtu

[Install]
WantedBy=multi-user.target
