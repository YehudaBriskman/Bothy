{
  "annotations": {
    "list": []
  },
  "description": "The edge, in two populations that are kept apart on purpose. Hand-written against docs/brand/patterns/dataviz.md; scripts/checks/dashboards.sh holds it there.",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": [
    "edge",
    "traefik"
  ],
  "timezone": "browser",
  "title": "Traefik - edge",
  "uid": "traefik-edge",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Entrypoints - every request that arrived",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requests / s",
      "description": "Every request that arrived on any entrypoint, whether a router matched it or not. This is the larger of the two populations on this dashboard: the Services row below counts only what was forwarded, and the difference is the tile to the right.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(traefik_entrypoint_requests_total[5m]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Not forwarded / s",
      "description": "Requests Traefik answered itself: a 404 because no router matched, a redirect, or a 401 from forwardAuth before the backend was reached. Shown as its own tile rather than folded into either population, because this is exactly the part the Services row below EXCLUDES. Over a recent day: 8,367 arrived, 8,328 were forwarded. It is a difference of two rates over the same window, so a momentary negative is a sampling artefact and is clamped to zero rather than drawn.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(sum(rate(traefik_entrypoint_requests_total[5m])) - sum(rate(traefik_service_requests_total[5m])), 0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "5xx / s",
      "description": "Server errors across all entrypoints. `or vector(0)` is deliberate: Traefik emits no 5xx child of this counter until the first one happens, so without it an edge that has never failed reads 'No data' - which looks like a broken panel rather than the good news it is. The thresholds are the only status colours on this row; the value itself is the primary encoder.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#34d399",
                "value": null
              },
              {
                "color": "#fbbf24",
                "value": 0.01
              },
              {
                "color": "#fb7185",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(traefik_entrypoint_requests_total{code=~\"5..\"}[5m])) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Config reload",
      "description": "1 while Traefik's last dynamic-configuration reload succeeded. A 0 here means the file provider rejected something in edge/dynamic/ and the edge is still serving the PREVIOUS config - so routes look fine and your edit did nothing. The word is the encoder; the colour repeats it.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILED",
                  "color": "#fb7185",
                  "index": 0
                },
                "1": {
                  "text": "ok",
                  "color": "#34d399",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "traefik_config_last_reload_success"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by status code",
      "description": "The same population as the four tiles above - everything that arrived - split by response code and stacked, so the bar height is the total and the segments add up to it. Segment colour is hashed from the code, not taken by position in the list, so 404 keeps its colour on a window where no 304 happened.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (rate(traefik_entrypoint_requests_total[5m]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Services - only what a router matched and forwarded",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate by service",
      "description": "Requests forwarded to each backend. A SMALLER whole than the Entrypoints row above: the 'Not forwarded / s' tile there is the remainder, and these two rows are kept in separate bands for that reason. Colour is hashed from the service name, so filtering one out does not repaint the others.",
      "gridPos": {
        "h": 9,
        "w": 9,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(traefik_service_requests_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by service",
      "description": "95th percentile of time-to-response per backend, from Traefik's own histogram. Seconds, on one axis - the request rate next to it is a different unit and is therefore a different chart rather than a second scale here. A gap means no request was forwarded in that step, which is not a latency of zero.",
      "gridPos": {
        "h": 9,
        "w": 9,
        "x": 9,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traefik_service_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "5xx by service, worst in window",
      "description": "One cell per backend that has ever returned a 5xx, showing its highest error rate anywhere in the dashboard's time range - so a spike an hour ago is still visible, which a 'last value' tile would have lost. 'none' means no backend has a 5xx counter at all. It is a cell per service rather than a chart because this is one number per service and it is nearly always zero.",
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 18,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "noValue": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#34d399",
                "value": null
              },
              {
                "color": "#fbbf24",
                "value": 0.0001
              },
              {
                "color": "#fb7185",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(traefik_service_requests_total{code=~\"5..\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ]
}
