    end

    subgraph s_filesnet["filesnet - exactly two members"]
        FILES["bothy-files<br/>editor + config forms"]
    end

    subgraph s_opsnet["opsnet - exactly two members"]
        OPS["bothy-ops<br/>container + cluster actions"]
    end

    subgraph s_ctlsock["controlsocknet - traefik is NOT a member"]
        WRITE["bothy-socket-write<br/>CONTAINERS=0 POST=1 EXEC=0<br/>restart / start / stop only"]
    end

    subgraph s_devnet["devnet - around two dozen containers"]
        OAUTH["oauth2-proxy"]
        OBS["monitoring - grafana, prometheus, loki,<br/>promtail, cadvisor, node-exporter"]
        APPSG["bothy-web"]
        DATAG["data - postgres plus its exporter - not routed"]
        PROJ["project containers<br/>e.g. cvops-nginx, cvops-garage"]
    end

    TRAEFIK["traefik<br/>on devnet, socketnet, filesnet and opsnet"]
    K8S["thales-scc - minikube's network<br/>joined only via compose.cluster.yml"]

    TRAEFIK --> OAUTH
    TRAEFIK --> OBS
    TRAEFIK --> APPSG
