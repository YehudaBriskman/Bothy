{
  "name": "bothy-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Bothy website: static, prerendered, built from this repository.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run prerender",
    "prerender": "vite build --ssr src/prerender.tsx --outDir dist-prerender && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint src scripts test public/sky-spike",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"test/**/*.test.mjs\"",
    "format": "prettier --write src scripts test public/sky-spike/*.js public/sky-spike/index.html",
    "format:check": "prettier --check src scripts test public/sky-spike/*.js public/sky-spike/index.html",
    "refresh-releases": "node scripts/refresh-releases.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "og": "node scripts/og.mjs",
    "verify": "bash scripts/verify-dist.sh",
    "render-console": "node scripts/render-console.mjs",
    "check-console": "node scripts/render-console.mjs --check",
    "check:sky": "node scripts/check-sky.mjs",
    "check:story": "node scripts/check-story.mjs",
    "check:sky:full": "node scripts/check-sky.mjs --full",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:meta": "node scripts/check-meta.mjs",
    "check:dist": "bash scripts/verify-dist.sh && node scripts/check-meta.mjs && node scripts/check-budgets.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:surfaces": "node scripts/check-surfaces.mjs"
  },
  "dependencies": {
    "marked": "^16.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.0",
    "postcss": "^8.5.33",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4"
  }
}
