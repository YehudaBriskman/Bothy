# Copy to .env and adjust. Dev-only defaults; not for production.
POSTGRES_USER=dev
POSTGRES_PASSWORD=changeme-generate-one   # e.g. openssl rand -base64 24
POSTGRES_DB=dev
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
# Grafana's admin email. Also the fallback for ALERT_EMAIL_TO below.
GRAFANA_ADMIN_EMAIL=admin@localhost

# Wiki.js database password. Wiki.js was superseded by apps/docs and is no
# longer started by `just up` (see up-apps in the justfile), so `just up` does
# NOT abort without this - the previous note here saying it did was stale.
# It is still required by apps/wiki/compose.yml, which uses `:?`, so it is
# needed the moment you run that file directly:
#   docker compose -f apps/wiki/compose.yml up -d
WIKI_DB_PASSWORD=changeme

# Grafana SMTP, for alert email
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
GF_SMTP_FROM_NAME=Grafana
GF_SMTP_STARTTLS_POLICY=OpportunisticStartTLS
ALERT_EMAIL_TO=

# ── SSO / oauth2-proxy ──────────────────────────────────────────────────────
# SSO is Keycloak via OIDC (not GitHub any more). oauth2-proxy runs with
# --provider=oidc against the `devbox` realm; the issuer URL and the redirect
# URL are both built from ${BOX_IP} in auth/compose.yml, so they always agree.
# The old GitHub OAuth App variables (OAUTH2_CLIENT_ID / OAUTH2_CLIENT_SECRET)
# are no longer read by anything - left here commented out so an existing .env
# carrying them is understood as a leftover rather than a missing setting.
#OAUTH2_CLIENT_ID=      # legacy GitHub OAuth App - unused since the Keycloak switch
#OAUTH2_CLIENT_SECRET=  # legacy GitHub OAuth App - unused since the Keycloak switch
OAUTH2_COOKIE_SECRET=   # openssl rand -base64 32 | tr -- '+/' '-_'

# ── Unified dev login (2026-08-08) ──────────────────────────────────────────
# One credential for every service with native auth: kafka-ui (LOGIN_FORM),
# grafana (via GRAFANA_* above), prometheus datasource wiring, dozzle and
# portainer hold it in their own stores. Compose interpolation requires both.
DEV_LOGIN_USER=dev@example.com
DEV_LOGIN_PASSWORD=change-me

# ── This node's tailnet IP ──────────────────────────────────────────────────
# Access is pure IP:port, so several URLs have to be built from a literal
# address rather than a name. BOX_IP is that address: it is baked into
# Keycloak's KC_HOSTNAME, the OIDC issuer URL oauth2-proxy validates, the
# redirect URI registered on the client, and the cookie whitelist domain.
# All of them are built from this one value so they cannot drift apart.
# Get it with: tailscale ip -4
# Change it and you must re-run `just up-auth`, or the issuer in the token
# will not match the issuer oauth2-proxy expects and every login fails.
BOX_IP=100.64.0.1

# ── Keycloak (identity provider for SSO) ────────────────────────────────────
# Password for Keycloak's own Postgres database. Only Keycloak uses it; it is
# not the shared POSTGRES_PASSWORD above. Rotating it here and running
# `just up-auth` is the supported way to change it.
KEYCLOAK_DB_PASSWORD=changeme

# Username of the Keycloak bootstrap admin in the master realm - the account
# you log into http://${BOX_IP}:8090/admin with. Read by auth/compose.yml as
# KC_BOOTSTRAP_ADMIN_USERNAME and by keycloak-init as KC_ADMIN_USER. It
# defaults to `admin` there (`${KEYCLOAK_ADMIN_USER:-admin}`), so this line is
# optional; it is spelled out so the admin username is discoverable from here.
#
# There is deliberately NO KEYCLOAK_ADMIN_PASSWORD. That variable used to be
# listed here and NOTHING read it - verified 2026-08-12 by grepping the repo:
# the only two Keycloak admin-credential references are KEYCLOAK_ADMIN_USER
# and DEV_LOGIN_PASSWORD (auth/compose.yml lines 159/312). The admin password
# IS DEV_LOGIN_PASSWORD above, per the one-unified-dev-login rule - so setting
# a KEYCLOAK_ADMIN_PASSWORD in .env changed nothing and quietly taught you the
# wrong password for the admin console.
KEYCLOAK_ADMIN_USER=admin

# Client secret for the `oauth2-proxy` confidential client in the `devbox`
# realm. Consumed twice and both must match: it is imported into the realm
# (as DEVBOX_OAUTH2_CLIENT_SECRET) and handed to oauth2-proxy itself (as
# OAUTH2_PROXY_CLIENT_SECRET). Generate with:
#   openssl rand -hex 32
KEYCLOAK_OAUTH2_CLIENT_SECRET=changeme
