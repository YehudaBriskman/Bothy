# Secrets — never commit real credentials
.env

# Defence in depth. apps/docs/content/ is a GENERATED mirror of the notes trees
# and is already ignored by apps/docs/.gitignore; these repeat the guard at the
# root so a single edited ignore file cannot publish live credentials from what
# is now a public repository. sync.sh also refuses to copy them in the first
# place — three independent layers, because the failure mode is unrecoverable.
apps/docs/content/
**/credentials.md
*.env
!.env.example

# Backups & local data
backups/
*.rdb
*.sql
*.sql.gz

# Logs / scratch
*.log
mgmt/dozzle-users.yml
monitoring/prometheus-web.yml
monitoring/prom-password.txt

# GENERATED by scripts/gen-portal-prom-route.sh. Carries the basic-auth header
# the edge injects on the portal's behalf, so it is a credential file.
# edge/dynamic/portal-prom.example.yml is the committed, redacted twin.
edge/dynamic/portal-prom.yml

# GENERATED every minute by apps/portal-collector, and it names PRIVATE WORK:
# project titles, descriptions and absolute paths under ~/projects. This repo is
# public, so publishing it would leak the contents of a private projects tree —
# and it would churn the diff on every collector run for a file nothing reads
# from git. The portal treats an absent file as a supported configuration and
# renders normally without it (see lib/api.ts).
apps/portal-next/data/projects.json
