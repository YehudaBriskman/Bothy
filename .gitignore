# Secrets - never commit real credentials
.env

# Defence in depth on a PUBLIC repository. `claude-notes/machine/credentials.md`
# holds live stack passwords, and nothing in this repo should ever be able to
# carry a copy of it in. The pattern stays even though the mirror that used to
# copy notes into this tree is gone: the guard costs one line and the failure it
# prevents is unrecoverable.
**/credentials.md
*.env
!.env.example

# Backups & local data
backups/
*.rdb
*.sql
*.sql.gz

# Logs / scratch
*.log
monitoring/prometheus-web.yml
monitoring/prom-password.txt

# GENERATED by scripts/gen-portal-prom-route.sh. Carries the basic-auth header
# the edge injects on the portal's behalf, so it is a credential file.
# edge/dynamic/portal-prom.example.yml is the committed, redacted twin.
edge/dynamic/portal-prom.yml

# GENERATED every minute by apps/portal-collector, and it names PRIVATE WORK:
# project titles, descriptions and absolute paths under ~/projects. This repo is
# public, so publishing it would leak the contents of a private projects tree -
# and it would churn the diff on every collector run for a file nothing reads
# from git. The portal treats an absent file as a supported configuration and
# renders normally without it (see lib/api.ts).
apps/portal-next/data/projects.json
# User themes: .css files somebody dropped into apps/portal-next/data/themes on
# their own box. Per-BOX by definition - the whole point is that they work
# without a source tree - so they are not this repository's business. The
# directory itself is tracked (.gitkeep) so a fresh clone has somewhere to put
# one, and so nginx has a directory to list rather than a 404.
apps/portal-next/data/themes/*.css

# Agent worktrees. Real git checkouts under the repo - never content of it.
.claude/worktrees/

# Reversible quarantine from /cleanup. Emptied by hand once the removals have
# been lived with; never content of the repo.
.cleanup-trash/

# Screenshots at the REPO ROOT are always an accident - a verification shot that
# was meant to be looked at and deleted. Two of them (edge-dark.png,
# services-1.png) reached main this way. Root-only on purpose: docs/assets holds
# the README images and must stay tracked.
/*.png
/*.jpg

# Python bytecode. One of these was committed (portal-collector) and travelled
# with every clone - a build artifact of whatever interpreter happened to run there.
__pycache__/
*.pyc

# A dozzle users file, still on disk from before mgmt/ was deleted. It holds an
# email and a bcrypt hash, so it must never be committed - and it WAS, once,
# because this line was removed as "a file in a directory that no longer exists"
# and `git add -A` then swept the untracked file it had been protecting. The
# directory is gone; the rule stays until the file does.
mgmt/dozzle-users.yml
