{
  "schema": 2,
  "mode": "mini",
  "title": "Bivvy",
  "project": "bothy",
  "reserve_mib": 512,
  "modules": [
    {
      "name": "edge",
      "description": "The front door - Traefik with the file provider only (no Docker socket), publishing the one host port.",
      "mem_mib": 128,
      "core": true,
      "requires": [],
      "provides": [
        "edge"
      ],
      "services": [
        "traefik"
      ],
      "files": [
        "traefik/dynamic/routes.yml"
      ],
      "mkdirs": [
        "traefik/dynamic"
      ]
    },
    {
      "name": "files",
      "description": "Read-only notes reader - one folder, no write routes (this box has no login yet).",
      "mem_mib": 256,
      "requires": [
        "edge"
      ],
      "provides": [
        "notes"
      ],
      "services": [
        "bothy-files"
      ],
      "files": [
        "bothy-files/policy/policy.toml"
      ],
      "mkdirs": [
        "bothy-files/notes",
        "bothy-files/policy"
      ]
    },
    {
      "name": "web",
      "description": "The portal page and /version.json.",
      "mem_mib": 64,
      "core": true,
      "requires": [
        "edge"
      ],
      "provides": [
        "portal"
      ],
      "services": [
        "bothy-web"
      ],
      "files": [],
      "mkdirs": [
        "bothy-web/data"
      ]
    }
  ],
  "services": [
    {
      "name": "bothy-files",
      "module": "files",
      "image_key": "bothy-files",
      "image_var": "BOTHY_IMAGE_BOTHY_FILES",
      "own": true,
      "mem_mib": 256
    },
    {
      "name": "bothy-web",
      "module": "web",
      "image_key": "bothy-web",
      "image_var": "BOTHY_IMAGE_BOTHY_WEB",
      "own": true,
      "mem_mib": 64
    },
    {
      "name": "traefik",
      "module": "edge",
      "image_key": "traefik",
      "image_var": "BOTHY_IMAGE_TRAEFIK",
      "own": false,
      "mem_mib": 128
    }
  ],
  "publish": [
    {
      "service": "traefik",
      "container": 80,
      "env": "BOTHY_HTTP_PORT",
      "default": 80
    }
  ],
  "mkdirs": [
    "bothy-files/notes",
    "bothy-files/policy",
    "bothy-web/data",
    "traefik/dynamic"
  ],
  "files": [
    "bothy-files/policy/policy.toml",
    "traefik/dynamic/routes.yml"
  ],
  "networks": [
    "bothy-devnet",
    "bothy-filesnet"
  ],
  "verify": {
    "version_path": "/version.json",
    "version_key": "revision",
    "bytes": [
      {
        "path": "/",
        "service": "bothy-web",
        "file": "/usr/share/nginx/html/index.html"
      }
    ]
  }
}
