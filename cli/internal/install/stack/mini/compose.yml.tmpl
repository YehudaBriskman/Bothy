# GENERATED by cli/cmd/stackgen from stack/modes.yml and the repo's compose files.
# Do not edit: run `go generate ./...` in cli/. Mode: mini.
name: bothy
networks:
  bothy-devnet:
    name: bothy-devnet
  bothy-filesnet:
    name: bothy-filesnet
services:
  bothy-files:
    command:
      - sh
      - -c
      - POLICY_FILE=/etc/bothy-files/policy.toml exec python3 -u app.py
    deploy:
      resources:
        limits:
          memory: 256m
    environment:
      AUDIT_LOG: /audit/writes.log
      CONFIG_AUDIT_LOG: /audit/patches.log
      HOME: /tmp
      PORT: 8099
    healthcheck:
      interval: 30s
      retries: 3
      start_period: 5s
      test:
        - CMD
        - python3
        - -c
        - import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8099/healthz',timeout=2).status==200 else 1)
      timeout: 3s
    image: '${BOTHY_IMAGE_BOTHY_FILES:?not set: run bothy install}'
    networks:
      - bothy-filesnet
    pull_policy: never
    read_only: true
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp
      - /audit
      - /var/lib/bothy/trash
      - /var/lib/bothy/config-trash
    user: ${PUID:-1000}:${PGID:-1000}
    volumes:
      - ./bothy-files/notes:/repos/notes:ro
      - ./bothy-files/policy:/etc/bothy-files:ro
  bothy-web:
    deploy:
      resources:
        limits:
          memory: 64m
    healthcheck:
      interval: 30s
      retries: 3
      start_interval: 2s
      start_period: 5s
      test:
        - CMD
        - wget
        - -qO
        - /dev/null
        - -T
        - "3"
        - http://127.0.0.1:8080/
      timeout: 3s
    image: '${BOTHY_IMAGE_BOTHY_WEB:?not set: run bothy install}'
    networks:
      - bothy-devnet
    pull_policy: never
    restart: unless-stopped
    volumes:
      - ./bothy-web/data:/usr/share/nginx/html/data:ro
  traefik:
    command:
      - --providers.file.directory=/etc/traefik/dynamic
      - --providers.file.watch=true
      - --entrypoints.web.address=:80
      - --api=true
      - --log.level=INFO
      - --accesslog=true
      - --entrypoints.metrics.address=127.0.0.1:8899
      - --metrics.prometheus=true
      - --metrics.prometheus.entryPoint=metrics
      - --metrics.prometheus.addEntryPointsLabels=true
      - --metrics.prometheus.addServicesLabels=true
      - --metrics.prometheus.addRoutersLabels=true
      - --ping=true
      - --ping.entrypoint=metrics
    deploy:
      resources:
        limits:
          memory: 128m
    healthcheck:
      interval: 30s
      retries: 3
      start_period: 5s
      test:
        - CMD
        - traefik
        - healthcheck
        - --ping=true
        - --ping.entrypoint=metrics
        - --entrypoints.metrics.address=127.0.0.1:8899
      timeout: 3s
    image: '${BOTHY_IMAGE_TRAEFIK:?not set: run bothy install}'
    labels:
      - dev.portal.project=Edge · Traefik
    networks:
      - bothy-devnet
      - bothy-filesnet
    ports:
      - ${BOTHY_BIND:-127.0.0.1}:${BOTHY_HTTP_PORT:-80}:80
    pull_policy: never
    restart: unless-stopped
    volumes:
      - ./traefik/dynamic:/etc/traefik/dynamic:ro
