# GENERATED by cli/cmd/stackgen: monitoring/compose.yml pruned to the services stack/modes.yml selects.
services:
  node-exporter:
    command:
      - --path.rootfs=/host
      - --collector.textfile.directory=/textfile
    container_name: node-exporter
    deploy:
      resources:
        limits:
          memory: 64m
    healthcheck:
      interval: 30s
      retries: 3
      start_period: 5s
      test:
        - CMD
        - wget
        - -qO
        - /dev/null
        - -T
        - "3"
        - http://127.0.0.1:9100/
      timeout: 3s
    image: node-exporter
    networks:
      - devnet
    ports:
      - 9100:9100
    restart: unless-stopped
    volumes:
      - /:/host:ro
      - bind:
          create_host_path: false
        read_only: true
        source: ${STATE_ROOT:-${HOME}/.local/state}/bothy/textfile
        target: /textfile
        type: bind
