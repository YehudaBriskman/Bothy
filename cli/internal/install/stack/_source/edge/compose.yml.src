# GENERATED by cli/cmd/stackgen: edge/compose.yml pruned to the services stack/modes.yml selects.
services:
  traefik:
    command:
      - --providers.docker=true
      - --providers.docker.exposedbydefault=false
      - --providers.docker.network=devnet
      - --providers.file.directory=/etc/traefik/dynamic
      - --providers.file.watch=true
      - --entrypoints.web.address=:80
      - --entrypoints.sandbox.address=:8100
      - --api=true
      - --log.level=INFO
      - --accesslog=true
      - --entrypoints.metrics.address=:8899
      - --metrics.prometheus=true
      - --metrics.prometheus.entryPoint=metrics
      - --metrics.prometheus.addEntryPointsLabels=true
      - --metrics.prometheus.addServicesLabels=true
      - --metrics.prometheus.addRoutersLabels=true
      - --ping=true
      - --ping.entrypoint=metrics
    container_name: traefik
    deploy:
      resources:
        limits:
          memory: 128m
    environment:
      DOCKER_API_VERSION: "1.44"
    extra_hosts:
      - host.docker.internal:host-gateway
    healthcheck:
      interval: 30s
      retries: 3
      start_period: 5s
      test:
        - CMD
        - traefik
        - healthcheck
        - --ping=true
        - --ping.entrypoint=metrics
        - --entrypoints.metrics.address=:8899
      timeout: 3s
    image: traefik
    labels:
      - dev.portal.project=Edge · Traefik
    networks:
      - devnet
      - socketnet
      - filesnet
      - opsnet
    ports:
      - 80:80
      - 8100:8100
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./dynamic:/etc/traefik/dynamic:ro
