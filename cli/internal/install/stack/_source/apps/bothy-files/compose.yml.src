# GENERATED by cli/cmd/stackgen: apps/bothy-files/compose.yml pruned to the services stack/modes.yml selects.
services:
  bothy-files:
    build: true
    container_name: bothy-files
    deploy:
      resources:
        limits:
          memory: 256m
    environment:
      AUDIT_LOG: /audit/writes.log
      CONFIG_AUDIT_LOG: /audit/patches.log
      HOME: /tmp
      PORT: 8099
    healthcheck:
      interval: 30s
      retries: 3
      start_period: 5s
      test:
        - CMD
        - python3
        - -c
        - import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8099/healthz',timeout=2).status==200 else 1)
      timeout: 3s
    image: bothy-files
    labels:
      - traefik.enable=false
    networks:
      - filesnet
    pull_policy: never
    read_only: true
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp
    user: ${PUID:-1000}:${PGID:-1000}
    volumes:
      - ../..:/repos/stacks:rw
      - ${NOTES_ROOT:-${HOME}/claude-notes}:/repos/notes:rw
      - ${PROJECTS_ROOT:-${HOME}/projects}:/repos/projects:ro
      - ${HOME_ROOT:-${HOME}}:/repos/home:ro
      - ./audit:/audit:rw
      - ${STATE_ROOT:-${HOME}/.local/state}/bothy/trash:/var/lib/bothy/trash:rw
      - ${STATE_ROOT:-${HOME}/.local/state}/bothy/config-trash:/var/lib/bothy/config-trash:rw
