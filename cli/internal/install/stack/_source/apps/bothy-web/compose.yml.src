# GENERATED by cli/cmd/stackgen: apps/bothy-web/compose.yml pruned to the services stack/modes.yml selects.
services:
  bothy-web:
    build: true
    container_name: bothy-web
    deploy:
      resources:
        limits:
          memory: 64m
    healthcheck:
      interval: 30s
      retries: 3
      start_interval: 2s
      start_period: 5s
      test:
        - CMD
        - wget
        - -qO
        - /dev/null
        - -T
        - "3"
        - http://127.0.0.1:8080/
      timeout: 3s
    image: bothy-web
    labels:
      - traefik.enable=true
      - traefik.http.services.bothy-web.loadbalancer.server.port=8080
      - traefik.http.routers.bothy-web-fallback.rule=PathPrefix(`/`)
      - traefik.http.routers.bothy-web-fallback.priority=1
      - traefik.http.routers.bothy-web-fallback.entrypoints=web
      - traefik.http.routers.bothy-web-fallback.service=bothy-web
    networks:
      - devnet
    pull_policy: never
    restart: unless-stopped
    volumes:
      - ./data:/usr/share/nginx/html/data:ro
